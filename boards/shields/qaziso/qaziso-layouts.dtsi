#include <physical_layouts.dtsi>

/ {
    physical_layout_qaziso: physical_layout_qaziso {
        compatible = "zmk,physical-layout";
        display-name = "qaziso";
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0   100     0>
            , <&key_physical_attrs 100 100  200    0       0   200     0>
            , <&key_physical_attrs 100 100  300    0       0   300     0>
            , <&key_physical_attrs 100 100  400    0       0   400     0>
            , <&key_physical_attrs 100 100  500    0       0   500     0>
            , <&key_physical_attrs 100 100  600    0       0   600     0>
            , <&key_physical_attrs 100 100  700    0       0   700     0>
            , <&key_physical_attrs 100 100  800    0       0   800     0>
            , <&key_physical_attrs 125 200  925    0       0   925     0>
            , <&key_physical_attrs 125 100    0  100       0     0   100>
            , <&key_physical_attrs 100 100  125  100       0   125   100>
            , <&key_physical_attrs 100 100  225  100       0   225   100>
            , <&key_physical_attrs 100 100  325  100       0   325   100>
            , <&key_physical_attrs 100 100  425  100       0   425   100>
            , <&key_physical_attrs 100 100  525  100       0   525   100>
            , <&key_physical_attrs 100 100  625  100       0   625   100>
            , <&key_physical_attrs 100 100  725  100       0   725   100>
            , <&key_physical_attrs 100 100  825  100       0   825   100>
            , <&key_physical_attrs 150 100    0  200       0     0   200>
            , <&key_physical_attrs 100 100  150  200       0   150   200>
            , <&key_physical_attrs 100 100  250  200       0   250   200>
            , <&key_physical_attrs 100 100  350  200       0   350   200>
            , <&key_physical_attrs 100 100  450  200       0   450   200>
            , <&key_physical_attrs 100 100  550  200       0   550   200>
            , <&key_physical_attrs 100 100  650  200       0   650   200>
            , <&key_physical_attrs 100 100  750  200       0   750   200>
            , <&key_physical_attrs 100 100  850  200       0   850   200>
            , <&key_physical_attrs 100 100  950  200       0   950   200>
            , <&key_physical_attrs 100 100    0  300       0     0   300>
            , <&key_physical_attrs 100 100  100  300       0   100   300>
            , <&key_physical_attrs 625 100  200  300       0   200   300>
            , <&key_physical_attrs 100 100  825  300       0   825   300>
            , <&key_physical_attrs 125 100  925  300       0   925   300>
            ;
    };
};
